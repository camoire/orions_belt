FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ffmpeg git && apt-get clean

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy local Qwen model into the image
COPY qwen_model_flat /models/qwen_model

# Copy local BLIP model into the image
COPY blip_model /models/blip_model

# Explicit model path for BLIP
ENV BLIP_MODEL_PATH=/models/blip_model

CMD ["bash"]
